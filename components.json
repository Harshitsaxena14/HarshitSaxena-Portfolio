{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tailwind": {
    "config": "tailwind.config.ts",
    "css": "src/app/globals.css",
    "baseColor": "slate",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils"
  },
  "registries": {
    "@shadcn": {
      "url": "https://ui.shadcn.com/r/{name}.json"
    },
    "@reactbits-starter": {
      "url": "https://starter.reactbits.dev/api/r/{name}.json"
    }
  }
}
